{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "clientes": {
      "root": "apps/alfajorge/clientes",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "VITE_APP_BASE=/clientes/ npm run build",
      "outputDirectory": "dist"
    },
    "empleados": {
      "root": "apps/alfajorge/empleados",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "VITE_APP_BASE=/empleados/ npm run build",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": {
        "service": "clientes"
      }
    },
    {
      "source": "/clientes",
      "destination": {
        "service": "clientes",
        "path": "/"
      }
    },
    {
      "source": "/clientes/:path*",
      "destination": {
        "service": "clientes",
        "path": "/:path*"
      }
    },
    {
      "source": "/empleados",
      "destination": {
        "service": "empleados",
        "path": "/"
      }
    },
    {
      "source": "/empleados/:path*",
      "destination": {
        "service": "empleados",
        "path": "/:path*"
      }
    }
  ]
}
