{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/clientes",
      "destination": "/clientes/index.html"
    },
    {
      "source": "/clientes/(.*)",
      "destination": "/clientes/index.html"
    },
    {
      "source": "/empleados",
      "destination": "/empleados/index.html"
    },
    {
      "source": "/empleados/(.*)",
      "destination": "/empleados/index.html"
    }
  ]
}
